rules_version = '2';
// RE : 지후배틀 (R2.0) — Firestore 규칙. 콘솔 → Firestore Database → 규칙에 이 파일 전체를 붙여넣어 게시한다.
// 지후배틀(R1) · 지후배틀 2 의 규칙은 이 파일로 대체된다 (R1 전체 규칙은 archive/v8.1 브랜치에 있다).
// R1 데이터: backups(가져오기용) · leaderboard(명예의 전당) 은 읽기만 · 나머지 R1 모드 컬렉션은 더 이상 열지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // 운영자: admins/{uid} 문서는 콘솔에서만 만든다
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 이용 정지: bans/{uid} 문서가 있고 기간(until, ms · 0 = 영구)이 남아 있으면
    function banned() {
      return request.auth != null && exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && (get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until == 0
          || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time.toMillis());
    }
    function validDeck(deck) {
      return deck is list && deck.size() <= 5
        && (deck.size() < 1 || (deck[0] is string && deck[0].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 2 || (deck[1] is string && deck[1].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 3 || (deck[2] is string && deck[2].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 4 || (deck[3] is string && deck[3].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 5 || (deck[4] is string && deck[4].matches('^[a-z_]{1,24}$')));
    }

    // ── 계정 · 기록 ──
    // R2 기록: r2_backups/{uid} = { payload(프로필 JSON), savedAt, updatedAt }
    match /r2_backups/{userId} {
      allow get, delete: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['payload', 'savedAt', 'updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt is timestamp;
    }
    // R1 기록: 처음 로그인할 때 한 번 가져오기만 한다 (더 이상 쓰지 않는다)
    match /backups/{userId} {
      allow get: if owner(userId);
      allow write: if false;
    }
    // 닉네임 로그인 · 친구 찾기 (R1 과 같은 등록부): 문서 ID 'n_' + 소문자 닉네임 · code 는 로그인한 계정 자신의 UID
    function validNickname(key, data) {
      return data.keys().hasAll(['owner', 'code', 'nickname', 'updatedAt'])
        && data.keys().hasOnly(['owner', 'code', 'nickname', 'updatedAt'])
        && data.owner == request.auth.uid
        && data.code is string && request.auth.token.email == data.code + '@jihoo-battle.invalid'
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && key == 'n_' + data.nickname.lower()
        && data.updatedAt is timestamp;
    }
    match /nicknames/{key} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && validNickname(key, request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validNickname(key, request.resource.data);
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    // 동시 접속 막기: 계정마다 지금 플레이 중인 창 번호 하나
    match /sessions/{userId} {
      allow get: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['sid', 'at'])
        && request.resource.data.sid is string && request.resource.data.sid.size() > 0 && request.resource.data.sid.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if owner(userId);
    }
    match /admins/{userId} {
      allow get: if owner(userId);
      allow list, write: if false;
    }
    match /bans/{userId} {
      allow get: if owner(userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['n', 'r', 'until', 'by', 'at'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 12
        && request.resource.data.r is string && request.resource.data.r.size() <= 100
        && request.resource.data.until is int && request.resource.data.until >= 0
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // ── 리더보드 ──
    // 시즌 R2: r2lb/{uid} = { nickname, level(0~), wins, losses, deck, fav, xp, updatedAt } · 게스트(익명)도 자기 문서만
    match /r2lb/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['nickname', 'level', 'wins', 'losses', 'deck', 'fav', 'xp', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12
        && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 999
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= 99999
        && request.resource.data.losses is int && request.resource.data.losses >= 0 && request.resource.data.losses <= 99999
        && validDeck(request.resource.data.deck)
        && request.resource.data.fav is string && (request.resource.data.fav == '' || request.resource.data.fav.matches('^[a-z_]{1,24}$'))
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 1000000
        && request.resource.data.updatedAt is timestamp;
    }
    // 명예의 전당: R1 레벨 리더보드 (읽기만 · 더 이상 바뀌지 않는다)
    match /leaderboard/{userId} {
      allow get, list: if true;
      allow write: if false;
    }

    // ── 운영: 점검 · 로비 공지 · 운영 우편 ──
    // config/maintenance = { on, msg, until, by, at } · config/announce = { on, msg, by, at } — 누구나 읽고(로그인 전에도) 운영자만 쓴다
    match /config/{docId} {
      allow get: if docId == 'maintenance' || docId == 'announce';
      allow list: if false;
      allow write: if docId == 'announce' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'msg', 'by', 'at'])
        && request.resource.data.on is bool
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow write: if docId == 'maintenance' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'msg', 'until', 'by', 'at'])
        && (!('until' in request.resource.data) || request.resource.data.until is int)
        && request.resource.data.on is bool
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }
    // 운영 우편: 운영자만 쓰고, 받는 사람(또는 전체)만 읽는다 · 받으면 claims/{uid} 에 닉네임을 남긴다 (운영자만 읽는다)
    match /giftMail/{giftId} {
      allow get, list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.to == 'all' || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.title is string
        && request.resource.data.rewards is list && request.resource.data.rewards.size() <= 6;
      allow update, delete: if false;
      match /claims/{userId} {
        allow create, update: if owner(userId)
          && (get(/databases/$(database)/documents/giftMail/$(giftId)).data.to in [userId, 'all'])
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 12
          && request.resource.data.at == request.time;
        allow get, list: if isAdmin();
        allow delete: if false;
      }
    }

    // ── 전체 채팅 · 공지 이벤트 ──
    // 누구나 읽고, 로그인한 계정만 자기 UID로 쓴다. 수정 · 삭제 불가 · at 는 서버 시각
    match /chat/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
        && request.resource.data.at == request.time;
    }
    match /events/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'type', 'a', 'b', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12
        && request.resource.data.type in ['level', 'join', 'gacha']
        && request.resource.data.a is string && request.resource.data.a.size() <= 40
        && request.resource.data.b is string && request.resource.data.b.size() <= 40
        && request.resource.data.at == request.time;
    }

    // ── 친구 · 접속 상태 · 1:1 채팅 ──
    // 접속 상태: 로그인한 사람은 누구나 읽고, 자기 것만 쓴다 (sp = 관전할 수 있는 친선전 번호)
    match /presence/{userId} {
      allow get: if request.auth != null;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['nickname', 'where', 'at', 'sp'])
        && (!('sp' in request.resource.data) || (request.resource.data.sp is string && request.resource.data.sp.size() <= 80))
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 12
        && request.resource.data.where is string && request.resource.data.where.size() <= 12
        && request.resource.data.at == request.time;
    }
    // 친구 관계: 문서 ID '작은UID_큰UID'. 요청한 사람이 만들고(pending), 받은 사람만 수락(accepted). 둘 중 누구나 삭제
    function friendOk(pairId) {
      let f = get(/databases/$(database)/documents/friendships/$(pairId));
      return f.data.status == 'accepted' && request.auth.uid in f.data.members;
    }
    function friendsWith(other) {
      return friendOk(request.auth.uid < other ? request.auth.uid + '_' + other : other + '_' + request.auth.uid);
    }
    match /friendships/{pairId} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['members', 'names', 'status', 'from', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names', 'at'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    // 1:1 채팅: 친구가 된 두 사람만 읽고 쓴다
    match /dm/{pairId}/msgs/{msgId} {
      allow read: if request.auth != null && friendOk(pairId);
      allow create: if request.auth != null && !banned() && friendOk(pairId)
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
    }

    // ── 친선전 (온라인 1:1) · 관전 ──
    // 방장(host)이 친구(guest)에게 신청. 두 사람만 상태 · 참가자 덱을 바꾼다. 진행 중인 판은 두 선수의 친구도 읽는다(관전).
    // cs = 코인 지후 시세 칸 (두 화면이 같은 값을 쓴다)
    function matchMember(id) {
      let m = get(/databases/$(database)/documents/matches/$(id));
      return request.auth.uid == m.data.host || request.auth.uid == m.data.guest;
    }
    function matchSpectator(id) {
      let m = get(/databases/$(database)/documents/matches/$(id));
      return m.data.status in ['playing', 'done'] && (friendsWith(m.data.host) || friendsWith(m.data.guest));
    }
    match /matches/{id} {
      allow get: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest
        || (resource.data.status in ['playing', 'done'] && (friendsWith(resource.data.host) || friendsWith(resource.data.guest))));
      allow list: if request.auth != null && request.auth.uid == resource.data.guest;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['host', 'guest', 'hostName', 'guestName', 'hostDeck', 'guestDeck', 'status', 'seed', 'cs', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string && request.resource.data.guest != request.auth.uid
        && friendsWith(request.resource.data.guest)
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 12
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 12
        && validDeck(request.resource.data.hostDeck) && request.resource.data.guestDeck is list && request.resource.data.guestDeck.size() == 0
        && request.resource.data.status == 'invite'
        && request.resource.data.seed is int
        && (!('cs' in request.resource.data) || request.resource.data.cs is int)
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guestDeck', 'at'])
        && request.resource.data.status in ['invite', 'accepted', 'declined', 'cancel', 'playing', 'done']
        && validDeck(request.resource.data.guestDeck)
        && request.resource.data.at == request.time;
    }
    match /matches/{id}/msgs/{msgId} {
      allow read: if request.auth != null && (matchMember(id) || matchSpectator(id));
      allow create: if request.auth != null && matchMember(id)
        && request.resource.data.keys().hasOnly(['from', 'body', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.at == request.time;
    }
  }
}
