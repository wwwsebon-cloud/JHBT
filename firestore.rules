rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function validDeck(deck) {
      return deck is list && deck.size() <= 5
        && (deck.size() < 1 || (deck[0] is string && deck[0].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 2 || (deck[1] is string && deck[1].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 3 || (deck[2] is string && deck[2].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 4 || (deck[3] is string && deck[3].matches('^[a-z_]{1,24}$')))
        && (deck.size() < 5 || (deck[4] is string && deck[4].matches('^[a-z_]{1,24}$')));
    }

    // ranks(지후별 랭크)와 masteryCounts(숙련 횟수)는 예전 클라이언트가 안 보내므로 선택 필드다.
    function validLeaderboard(data) {
      return data.keys().hasAll(['nickname', 'level', 'deck', 'wins', 'losses', 'playMs', 'favorite', 'updatedAt'])
        && data.keys().hasOnly(['nickname', 'level', 'deck', 'wins', 'losses', 'playMs', 'favorite', 'ranks', 'masteryCounts', 'look', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && data.level is int && data.level >= 1 && data.level <= 100
        && validDeck(data.deck)
        && data.wins is int && data.wins >= 0 && data.wins <= 99999
        && data.losses is int && data.losses >= 0 && data.losses <= 99999
        && data.playMs is int && data.playMs >= 0 && data.playMs <= 315360000000
        && data.favorite is string && (data.favorite == '' || data.favorite.matches('^[a-z_]{1,24}$'))
        && (!('ranks' in data) || data.ranks is map)
        && (!('masteryCounts' in data) || data.masteryCounts is map)
        // 4.3 프로필 꾸미기: { a: 대표 지후, f: 테두리, t: 칭호, c: 카드 색 }
        && (!('look' in data) || (data.look is map && data.look.keys().hasOnly(['a', 'f', 't', 'c'])
            && data.look.a is string && data.look.a.size() <= 24 && data.look.f is string && data.look.f.size() <= 12
            && data.look.t is string && data.look.t.size() <= 40 && data.look.c is string && data.look.c.size() <= 12))
        && data.updatedAt is timestamp;
    }

    // 닉네임 로그인용: 문서 ID는 'n_' + 소문자 닉네임, code 는 로그인한 계정 자신의 UID여야 한다.
    function validNickname(key, data) {
      return data.keys().hasAll(['owner', 'code', 'nickname', 'updatedAt'])
        && data.keys().hasOnly(['owner', 'code', 'nickname', 'updatedAt'])
        && data.owner == request.auth.uid
        && data.code is string && request.auth.token.email == data.code + '@jihoo-battle.invalid'
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && key == 'n_' + data.nickname.lower()
        && data.updatedAt is timestamp;
    }

    // 경쟁전 리더보드: 티어 점수와 경쟁전 전적, 마지막 3:3 덱
    function validCompLeaderboard(data) {
      return data.keys().hasAll(['nickname', 'tp', 'wins', 'losses', 'deck', 'updatedAt'])
        && data.keys().hasOnly(['nickname', 'tp', 'wins', 'losses', 'deck', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && data.tp is int && data.tp >= 0 && data.tp <= 999999
        && data.wins is int && data.wins >= 0 && data.wins <= 99999
        && data.losses is int && data.losses >= 0 && data.losses <= 99999
        && validDeck(data.deck) && data.deck.size() <= 3
        && data.updatedAt is timestamp;
    }

    // 4.4 시즌 리더보드: seasons/{시즌}/lb · seasons/{시즌}/comp. 이번 달(UTC 기준 또는 한국 시간으로 이미 넘어간 다음 달) 시즌에만 쓸 수 있다.
    function currentSeason(season) {
      return int(season) == (request.time.year() - 2026) * 12 + request.time.month() - 8
        || int(season) == (request.time.year() - 2026) * 12 + request.time.month() - 7;
    }
    function validSeasonLb(data) {
      return data.keys().hasAll(['nickname', 'level', 'deck', 'wins', 'losses', 'playMs', 'favorite', 'xp', 'updatedAt'])
        && data.keys().hasOnly(['nickname', 'level', 'deck', 'wins', 'losses', 'playMs', 'favorite', 'ranks', 'masteryCounts', 'look', 'xp', 'updatedAt'])
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && data.level is int && data.level >= 1 && data.level <= 150
        && validDeck(data.deck)
        && data.wins is int && data.wins >= 0 && data.wins <= 99999
        && data.losses is int && data.losses >= 0 && data.losses <= 99999
        && data.playMs is int && data.playMs >= 0 && data.playMs <= 315360000000
        && data.favorite is string && (data.favorite == '' || data.favorite.matches('^[a-z_]{1,24}$'))
        && data.xp is int && data.xp >= 0 && data.xp <= 999999999
        && (!('ranks' in data) || data.ranks is map)
        && (!('masteryCounts' in data) || data.masteryCounts is map)
        && (!('look' in data) || data.look is map)
        && data.updatedAt is timestamp;
    }

    function validBackup(data) {
      return data.keys().hasAll(['payload', 'updatedAt'])
        && data.keys().hasOnly(['payload', 'updatedAt'])
        && data.payload is string && data.payload.size() <= 100000
        && data.updatedAt is timestamp;
    }

    // 4.1.4 글로벌 채팅: 누구나 읽고, 로그인한 계정만 자기 UID로 쓴다. 수정·삭제 불가. at 는 서버 시각이어야 한다.
    function validChat(data) {
      return data.keys().hasAll(['uid', 'nickname', 'text', 'at'])
        && data.keys().hasOnly(['uid', 'nickname', 'text', 'at'])
        && data.uid == request.auth.uid
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && data.text is string && data.text.size() > 0 && data.text.size() <= 120
        && data.at == request.time;
    }

    // 4.1.4 공지 이벤트 (레벨업·가입·뽑기·랭크·마스터리·승급)
    function validEvent(data) {
      return data.keys().hasAll(['uid', 'nickname', 'type', 'a', 'b', 'at'])
        && data.keys().hasOnly(['uid', 'nickname', 'type', 'a', 'b', 'at'])
        && data.uid == request.auth.uid
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12
        && data.type in ['level', 'join', 'gacha', 'rank', 'mastery', 'promo']
        && data.a is string && data.a.size() <= 40
        && data.b is string && data.b.size() <= 40
        && data.at == request.time;
    }

    // 4.1.6 동시접속 차단: 계정마다 지금 플레이 중인 세션 번호 하나
    function validSession(data) {
      return data.keys().hasAll(['sid', 'at']) && data.keys().hasOnly(['sid', 'at'])
        && data.sid is string && data.sid.size() > 0 && data.sid.size() <= 40
        && data.at == request.time;
    }

    match /sessions/{userId} {
      allow get: if owner(userId);
      allow create, update: if owner(userId) && validSession(request.resource.data);
      allow delete: if owner(userId);
    }

    match /chat/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && validChat(request.resource.data);
    }

    match /events/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && validEvent(request.resource.data);
    }

    match /nicknames/{key} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && validNickname(key, request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validNickname(key, request.resource.data);
      allow delete: if request.auth != null && resource.data.owner == request.auth.uid;
    }

    match /backups/{userId} {
      allow get, delete: if owner(userId);
      allow create, update: if owner(userId) && validBackup(request.resource.data);
    }

    match /compLeaderboard/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId);
      allow create, update: if owner(userId) && validCompLeaderboard(request.resource.data);
    }

    // 5.4 협동전 리더보드: 최고 웨이브 · 덱
    // 5.5 운영 우편: admins/{uid} 문서는 콘솔에서만 만든다. 운영자만 giftMail 을 쓸 수 있고, 받는 사람(또는 전체)만 읽는다.
    match /admins/{userId} {
      allow get: if owner(userId);
      allow list, write: if false;
    }
    match /giftMail/{giftId} {
      allow get, list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.to == 'all');
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.title is string
        && request.resource.data.rewards is list && request.resource.data.rewards.size() <= 6;
      allow update, delete: if false;
    }

    match /coopLeaderboard/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasAll(['nickname', 'wave', 'deck', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['nickname', 'wave', 'deck', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12
        && request.resource.data.wave is int && request.resource.data.wave >= 0 && request.resource.data.wave <= 99999
        && validDeck(request.resource.data.deck)
        && request.resource.data.updatedAt is timestamp;
    }

    match /leaderboard/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId);
      allow create, update: if owner(userId) && validLeaderboard(request.resource.data);
    }

    match /seasons/{season}/lb/{userId} {
      allow get, list: if true;
      allow create, update: if owner(userId) && currentSeason(season) && validSeasonLb(request.resource.data);
    }

    // 4.5: 경쟁전은 지난 시즌 최종 기록(finalSnap)도 한 번 올린다 → 이번 달 · 다음 달 · 지난 달 시즌 허용
    match /seasons/{season}/comp/{userId} {
      allow get, list: if true;
      allow create, update: if owner(userId) && (currentSeason(season) || int(season) == (request.time.year() - 2026) * 12 + request.time.month() - 9) && validCompLeaderboard(request.resource.data);
    }
    // ── 5.0 친구 · 접속 상태 · 1:1 채팅 · 친선전 ──
    // 접속 상태: 로그인한 사람은 누구나 읽고, 자기 것만 쓴다 (at 는 서버 시각)
    match /presence/{userId} {
      allow get: if request.auth != null;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['nickname', 'where', 'at'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 12
        && request.resource.data.where is string && request.resource.data.where.size() <= 12
        && request.resource.data.at == request.time;
    }

    // 친구 관계: 문서 ID 는 '작은UID_큰UID'. 요청한 사람이 만들고(pending), 받은 사람만 수락(accepted). 둘 중 누구나 삭제.
    function friendOk(pairId) {
      let f = get(/databases/$(database)/documents/friendships/$(pairId));
      return f.data.status == 'accepted' && request.auth.uid in f.data.members;
    }
    match /friendships/{pairId} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['members', 'names', 'status', 'from', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names', 'at'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }

    // 1:1 채팅: 친구가 된 두 사람만 읽고 쓴다
    match /dm/{pairId}/msgs/{msgId} {
      allow read: if request.auth != null && friendOk(pairId);
      allow create: if request.auth != null && friendOk(pairId)
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
    }

    // 친선전: 방장(host)이 친구(guest)에게 초대. 두 사람만 읽고, 상태·참가자 덱만 바꿀 수 있다.
    function matchMember(id) {
      let m = get(/databases/$(database)/documents/matches/$(id));
      return request.auth.uid == m.data.host || request.auth.uid == m.data.guest;
    }
    match /matches/{id} {
      allow get: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest);
      allow list: if request.auth != null && request.auth.uid == resource.data.guest;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host', 'guest', 'hostName', 'guestName', 'hostDeck', 'guestDeck', 'status', 'seed', 'ew', 'at'])
        && (!('ew' in request.resource.data) || request.resource.data.ew is bool)
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string && request.resource.data.guest != request.auth.uid
        && (exists(/databases/$(database)/documents/friendships/$(request.auth.uid + '_' + request.resource.data.guest))
            || exists(/databases/$(database)/documents/friendships/$(request.resource.data.guest + '_' + request.auth.uid)))
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 12
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 12
        && validDeck(request.resource.data.hostDeck) && request.resource.data.guestDeck is list && request.resource.data.guestDeck.size() == 0
        && request.resource.data.status == 'invite'
        && request.resource.data.seed is int
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guestDeck', 'at'])
        && request.resource.data.status in ['invite', 'accepted', 'declined', 'cancel', 'playing', 'done']
        && validDeck(request.resource.data.guestDeck)
        && request.resource.data.at == request.time;
    }
    // 5.5 2:2 온라인 방: 방장은 방을 마음대로 바꾸고, 다른 사람은 열린 방에 자기 자리만 넣거나 뺀다 (최대 4명)
    function validRoomPlayers(ps) {
      return ps is map && ps.size() <= 4;
    }
    function roomMember(id) {
      return request.auth.uid in get(/databases/$(database)/documents/rooms/$(id)).data.players;
    }
    match /rooms/{id} {
      allow get, list: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['host', 'hostName', 'title', 'status', 'players', 'seed', 'ew', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.status == 'open'
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 12
        && request.resource.data.title is string && request.resource.data.title.size() <= 24
        && validRoomPlayers(request.resource.data.players)
        && request.resource.data.players.keys().hasOnly([request.auth.uid])
        && request.resource.data.seed is int
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && validRoomPlayers(request.resource.data.players)
        && request.resource.data.host == resource.data.host
        && (request.auth.uid == resource.data.host
            || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['players', 'at'])
                && request.resource.data.players.diff(resource.data.players).affectedKeys().hasOnly([request.auth.uid])
                && (resource.data.status == 'open' || !(request.auth.uid in request.resource.data.players))));
      allow delete: if request.auth != null && request.auth.uid == resource.data.host;
    }
    match /rooms/{id}/msgs/{msgId} {
      allow read: if request.auth != null && roomMember(id);
      allow create: if request.auth != null && roomMember(id)
        && request.resource.data.keys().hasOnly(['from', 'body', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.at == request.time;
    }
    match /matches/{id}/msgs/{msgId} {
      allow read: if request.auth != null && matchMember(id);
      allow create: if request.auth != null && matchMember(id)
        && request.resource.data.keys().hasOnly(['from', 'body', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.at == request.time;
    }
  }
}
