rules_version = '2';
// RE : 지후배틀 (R2.0) — Firestore 규칙. 콘솔 → Firestore Database → 규칙에 이 파일 전체를 붙여넣어 게시한다.
// 지후배틀(R1) · 지후배틀 2 의 규칙은 이 파일로 대체된다 (R1 전체 규칙은 archive/v8.1 브랜치에 있다).
// R1 데이터: backups(가져오기용) · leaderboard(명예의 전당) 은 읽기만 · 나머지 R1 모드 컬렉션은 더 이상 열지 않는다.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // 운영자: admins/{uid} 문서는 콘솔에서만 만든다
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    // 이용 정지: bans/{uid} 문서가 있고 기간(until, ms · 0 = 영구)이 남아 있으면
    function banned() {
      return request.auth != null && exists(/databases/$(database)/documents/bans/$(request.auth.uid))
        && (get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until == 0
          || get(/databases/$(database)/documents/bans/$(request.auth.uid)).data.until > request.time.toMillis());
    }
    function validDeck(deck) {
      return deck is list && deck.size() <= 5
        && (deck.size() < 1 || (deck[0] is string && deck[0].matches('^[a-z][a-z0-9_]{0,23}$')))
        && (deck.size() < 2 || (deck[1] is string && deck[1].matches('^[a-z][a-z0-9_]{0,23}$')))
        && (deck.size() < 3 || (deck[2] is string && deck[2].matches('^[a-z][a-z0-9_]{0,23}$')))
        && (deck.size() < 4 || (deck[3] is string && deck[3].matches('^[a-z][a-z0-9_]{0,23}$')))
        && (deck.size() < 5 || (deck[4] is string && deck[4].matches('^[a-z][a-z0-9_]{0,23}$')));
    }

    // ── 계정 · 기록 ──
    // R2 기록: r2_backups/{uid} = { payload(프로필 JSON), savedAt, updatedAt }
    match /r2_backups/{userId} {
      allow get: if owner(userId) || isAdmin(); // R2.12: 운영자는 의심 계정 기록을 본다 (핵 방지)
      allow delete: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['payload', 'savedAt', 'updatedAt'])
        && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000
        && request.resource.data.savedAt is int
        && request.resource.data.updatedAt is timestamp;
      // R2.20 build 3 서버 이력: 3시간마다 한 칸 (t0~t7) · 기록을 고를 때 버린 쪽 (x0~x3) — 운영자가 사라진 지후를 찾는다
      match /hist/{slot} {
        allow get, list: if owner(userId) || isAdmin();
        allow create, update: if owner(userId) && slot.matches('^[tx][0-7]$')
          && request.resource.data.keys().hasOnly(['payload', 'savedAt', 'updatedAt'])
          && request.resource.data.payload is string && request.resource.data.payload.size() <= 100000
          && request.resource.data.savedAt is int
          && request.resource.data.updatedAt is timestamp;
      }
    }
    // R1 기록: 처음 로그인할 때 한 번 가져오기만 한다 (더 이상 쓰지 않는다)
    match /backups/{userId} {
      allow get: if owner(userId);
      allow write: if false;
    }
    // R2.17.2 닉네임 욕설 · 패드립 · 극우 표현 (게임 화면 검사의 핵심만 · 공백 · 숫자 · 기호를 빼고 본다)
    function cleanName(n) {
      return !n.lower().replace('[^가-힣ㄱ-ㅎㅏ-ㅣa-z]', '').matches('.*(씨발|시발|씨팔|시팔|씹|병신|븅신|지랄|좆|존나|개새|새끼|느금|느그어|느그엄|니애미|니애비|니미|애미|애비|엠창|엄창|창녀|섹스|보지|자지|노무현|운지|노알라|엠씨무현|mc무현|무현이|일베|홍어|운영자|관리자|fuck|shit|bitch|nigger).*');
    }
    // 닉네임 로그인 · 친구 찾기 (R1 과 같은 등록부): 문서 ID 'n_' + 소문자 닉네임 · code 는 로그인한 계정 자신의 UID
    function validNickname(key, data) {
      return data.keys().hasAll(['owner', 'code', 'nickname', 'updatedAt'])
        && data.keys().hasOnly(['owner', 'code', 'nickname', 'updatedAt'])
        && data.owner == request.auth.uid
        && data.code is string && request.auth.token.email == data.code + '@jihoo-battle.invalid'
        && data.nickname is string && data.nickname.size() > 0 && data.nickname.size() <= 12 && cleanName(data.nickname)
        && key == 'n_' + data.nickname.lower()
        && data.updatedAt is timestamp;
    }
    match /nicknames/{key} {
      allow get: if true;
      allow list: if request.auth != null && resource.data.owner == request.auth.uid;
      allow create: if request.auth != null && validNickname(key, request.resource.data);
      allow update: if request.auth != null && resource.data.owner == request.auth.uid && validNickname(key, request.resource.data);
      allow delete: if request.auth != null && (resource.data.owner == request.auth.uid || isAdmin());
    }
    // 동시 접속 막기: 계정마다 지금 플레이 중인 창 번호 하나
    match /sessions/{userId} {
      allow get: if owner(userId);
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['sid', 'at'])
        && request.resource.data.sid is string && request.resource.data.sid.size() > 0 && request.resource.data.sid.size() <= 40
        && request.resource.data.at == request.time;
      allow delete: if owner(userId);
    }
    match /admins/{userId} {
      allow get: if owner(userId);
      allow list, write: if false;
    }
    match /bans/{userId} {
      allow get: if owner(userId) || isAdmin();
      allow list, delete: if isAdmin();
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['n', 'r', 'until', 'by', 'at'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 12
        && request.resource.data.r is string && request.resource.data.r.size() <= 100
        && request.resource.data.until is int && request.resource.data.until >= 0
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }

    // ── 리더보드 ──
    // 시즌 R2: r2lb/{uid} = { nickname, level(0~), wins, losses, deck, fav, xp, frame(프로필 테두리 · 없어도 됨), cp(전투력 · R2.21 · 없어도 됨), updatedAt } · 게스트(익명)도 자기 문서만
    // R2.7.2 경쟁전 리더보드: r2comp/{시즌}_{uid} = { nickname, tp, season, wins, losses, fav, frame(없어도 됨), updatedAt } · 시즌마다 따로 남는다 (지난 시즌 순위 보상)
    match /r2comp/{docId} {
      allow get, list: if true;
      allow delete: if isAdmin();
      allow create, update: if request.auth != null && !banned()
        && request.resource.data.season is int && request.resource.data.season >= 1 && request.resource.data.season <= 100000
        && docId == string(request.resource.data.season) + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(['nickname', 'tp', 'season', 'wins', 'losses', 'fav', 'frame', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.tp is int && request.resource.data.tp >= 0 && request.resource.data.tp <= 10000000
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= 99999
        && request.resource.data.losses is int && request.resource.data.losses >= 0 && request.resource.data.losses <= 99999
        && request.resource.data.fav is string && (request.resource.data.fav == '' || request.resource.data.fav.matches('^[a-z][a-z0-9_]{0,23}$'))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.matches('^[a-z0-9]{1,8}$')))
        && request.resource.data.updatedAt is timestamp;
    }
    // R2.7.2 경쟁전 봇 학습: r2picks/{uid} = { picks, pwins, bans, norm, nwins (지후 id → 횟수), updatedAt } · 로그인한 사람 모두 읽기 (봇이 합산)
    match /r2picks/{userId} {
      allow get, list: if request.auth != null;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['picks', 'pwins', 'bans', 'norm', 'nwins', 'updatedAt'])
        && request.resource.data.picks is map && request.resource.data.picks.size() <= 100
        && request.resource.data.pwins is map && request.resource.data.pwins.size() <= 100
        && request.resource.data.bans is map && request.resource.data.bans.size() <= 100
        && request.resource.data.norm is map && request.resource.data.norm.size() <= 100
        && request.resource.data.nwins is map && request.resource.data.nwins.size() <= 100
        && request.resource.data.updatedAt is timestamp;
    }
    // R2.14 리플레이 공유: r2rp/{uid}_{at} = { by, nick, pn, on, win, kind, n(라운드), b(빌드), at, d(JSON 문자열: me · rounds), created } · 링크(문서 id)만 있으면 누구나 읽기 (로그인 없이 재생) · 목록은 못 본다
    match /r2rp/{id} {
      allow get: if true;
      allow list: if false;
      allow delete: if (request.auth != null && resource.data.by == request.auth.uid) || isAdmin();
      allow create, update: if request.auth != null && !banned()
        && id.matches(request.auth.uid + '_[0-9]{10,16}')
        && request.resource.data.keys().hasOnly(['by', 'nick', 'pn', 'on', 'win', 'kind', 'n', 'b', 'at', 'd', 'created'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.nick is string && request.resource.data.nick.size() <= 12
        && request.resource.data.pn is string && request.resource.data.pn.size() <= 12
        && request.resource.data.on is string && request.resource.data.on.size() <= 12
        && request.resource.data.win is bool
        && request.resource.data.kind is string && request.resource.data.kind.size() <= 12
        && request.resource.data.n is int && request.resource.data.n >= 1 && request.resource.data.n <= 60
        && request.resource.data.b is string && request.resource.data.b.size() <= 24
        && request.resource.data.at is int
        && request.resource.data.d is string && request.resource.data.d.size() <= 400000
        && request.resource.data.created == request.time;
    }
    // R2.7.2 지후의 탑 리더보드: r2tower/{uid} = { nickname, best(최고 층), fav, frame(없어도 됨), updatedAt }
    // R2.13.2 크레딧 USERS: 한 판이라도 한 모든 닉네임 (게스트 익명 로그인 포함) · uid 마다 한 문서
    // R2.26 업데이트 알림: 기기 알림 토큰 (자기 문서만 쓰기 · 읽기는 아무도 — 보내기는 서비스 계정 tools/push-send.js 가 규칙을 건너뛴다)
    match /push_tokens/{userId} {
      allow read: if false;
      allow create, update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['token', 'updatedAt', 'app'])
        && request.resource.data.token is string && request.resource.data.token.size() > 20 && request.resource.data.token.size() <= 600
        && request.resource.data.updatedAt == request.time
        && (!('app' in request.resource.data) || request.resource.data.app in [0, 1]);
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /r2users/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['nickname', 'at'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.at == request.time;
    }
    function rkI(l, i) { return l.size() <= i || (l[i] is int && l[i] >= 1 && l[i] <= 6); } // R2.28
    function rkOk(l) { return l is list && l.size() <= 5 && rkI(l, 0) && rkI(l, 1) && rkI(l, 2) && rkI(l, 3) && rkI(l, 4); }
    // R2.34 디펜스 리더보드: 최고 웨이브 (r2tower 와 같은 모양) · R2.35 build 11: 최고 기록 덱 deck · 그때 랭크 rk (없어도 됨)
    match /r2def/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['nickname', 'best', 'fav', 'frame', 'deck', 'rk', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 100000
        && request.resource.data.fav is string && (request.resource.data.fav == '' || request.resource.data.fav.matches('^[a-z][a-z0-9_]{0,23}$'))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.matches('^[a-z0-9]{1,8}$')))
        && (!('deck' in request.resource.data) || validDeck(request.resource.data.deck))
        && (!('rk' in request.resource.data) || rkOk(request.resource.data.rk))
        && request.resource.data.updatedAt is timestamp;
    }
    match /r2tower/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['nickname', 'best', 'fav', 'frame', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.best is int && request.resource.data.best >= 0 && request.resource.data.best <= 100000
        && request.resource.data.fav is string && (request.resource.data.fav == '' || request.resource.data.fav.matches('^[a-z][a-z0-9_]{0,23}$'))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.matches('^[a-z0-9]{1,8}$')))
        && request.resource.data.updatedAt is timestamp;
    }
    match /r2lb/{userId} {
      allow get, list: if true;
      allow delete: if owner(userId) || isAdmin();
      allow create, update: if owner(userId) && !banned()
        && request.resource.data.keys().hasOnly(['nickname', 'level', 'wins', 'losses', 'deck', 'fav', 'xp', 'frame', 'dia', 'gold', 'pulls', 'own', 'cheat', 'cp', 'rk', 'updatedAt'])
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.level is int && request.resource.data.level >= 0 && request.resource.data.level <= 999
        && request.resource.data.wins is int && request.resource.data.wins >= 0 && request.resource.data.wins <= 99999
        && request.resource.data.losses is int && request.resource.data.losses >= 0 && request.resource.data.losses <= 99999
        && validDeck(request.resource.data.deck)
        && request.resource.data.fav is string && (request.resource.data.fav == '' || request.resource.data.fav.matches('^[a-z][a-z0-9_]{0,23}$'))
        && request.resource.data.xp is int && request.resource.data.xp >= 0 && request.resource.data.xp <= 1000000
        // R2.12 핵 방지: 재화 · 뽑기 수 · 보유 지후 수 · 핵 흔적 (운영 도구 '의심 계정') · 없어도 됨
        && (!('dia' in request.resource.data) || (request.resource.data.dia is int && request.resource.data.dia >= 0 && request.resource.data.dia <= 99999999))
        && (!('gold' in request.resource.data) || (request.resource.data.gold is int && request.resource.data.gold >= 0 && request.resource.data.gold <= 999999999))
        && (!('pulls' in request.resource.data) || (request.resource.data.pulls is int && request.resource.data.pulls >= 0 && request.resource.data.pulls <= 999999))
        && (!('own' in request.resource.data) || (request.resource.data.own is int && request.resource.data.own >= 0 && request.resource.data.own <= 999))
        && (!('cheat' in request.resource.data) || (request.resource.data.cheat is int && request.resource.data.cheat >= 0 && request.resource.data.cheat <= 9999))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.matches('^[a-z0-9]{1,8}$')))
        && (!('cp' in request.resource.data) || (request.resource.data.cp is int && request.resource.data.cp >= 0 && request.resource.data.cp <= 99999999)) // R2.21 전투력
        && (!('rk' in request.resource.data) || rkOk(request.resource.data.rk)) // R2.28 덱 지후 랭크 (리더보드 표시)
        && request.resource.data.updatedAt is timestamp;
    }
    // 명예의 전당: R1 레벨 리더보드 (읽기만 · 더 이상 바뀌지 않는다)
    match /leaderboard/{userId} {
      allow get, list: if true;
      allow write: if false;
    }

    // ── 운영: 점검 · 로비 공지 · 운영 우편 ──
    // config/maintenance = { on, msg, until, by, at } · config/announce = { on, msg, by, at } — 누구나 읽고(로그인 전에도) 운영자만 쓴다
    match /config/{docId} {
      allow get: if docId == 'maintenance' || docId == 'announce' || docId == 'tier' || docId == 'bcast';
      allow list: if false;
      allow write: if docId == 'announce' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'msg', 'by', 'at'])
        && request.resource.data.on is bool
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      // R3.5: config/bcast = 운영자 메시지 (모든 화면 맨 위 띠) { on, msg, sec (띄울 초), by, at }
      allow write: if docId == 'bcast' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'msg', 'sec', 'by', 'at'])
        && request.resource.data.on is bool
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.sec is int && request.resource.data.sec >= 5 && request.resource.data.sec <= 60
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      // R3.2 build 15: config/tier = 티어리스트 생성기로 등재한 티어표 { on, sc (JSON 글 · id → 점수), n 판 수, ver, by, at }
      allow write: if docId == 'tier' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'sc', 'n', 'ver', 'by', 'at'])
        && request.resource.data.on is bool
        && request.resource.data.sc is string && request.resource.data.sc.size() <= 20000
        && request.resource.data.n is int
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
      allow write: if docId == 'maintenance' && isAdmin()
        && request.resource.data.keys().hasOnly(['on', 'msg', 'until', 'by', 'at'])
        && (!('until' in request.resource.data) || request.resource.data.until is int)
        && request.resource.data.on is bool
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 200
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at == request.time;
    }
    // 운영 우편: 운영자만 쓰고, 받는 사람(또는 전체)만 읽는다 · 받으면 claims/{uid} 에 닉네임을 남긴다 (운영자만 읽는다)
    match /giftMail/{giftId} {
      allow get, list: if request.auth != null && (resource.data.to == request.auth.uid || resource.data.to == 'all' || isAdmin());
      allow create: if isAdmin()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.to is string && request.resource.data.title is string
        && request.resource.data.rewards is list && request.resource.data.rewards.size() <= 6;
      allow update, delete: if false;
      match /claims/{userId} {
        allow create, update: if owner(userId)
          && (get(/databases/$(database)/documents/giftMail/$(giftId)).data.to in [userId, 'all'])
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 12
          && request.resource.data.at == request.time;
        allow get, list: if isAdmin();
        allow delete: if false;
      }
    }

    // ── 전체 채팅 · 공지 이벤트 ──
    // 누구나 읽고, 로그인한 계정만 자기 UID로 쓴다. 수정 · 삭제 불가 · at 는 서버 시각
    match /chat/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 120
        && request.resource.data.at == request.time;
    }
    match /events/{id} {
      allow get, list: if true;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['uid', 'nickname', 'type', 'a', 'b', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string && request.resource.data.nickname.size() > 0 && request.resource.data.nickname.size() <= 12 && cleanName(request.resource.data.nickname)
        && request.resource.data.type in ['level', 'join', 'gacha', 'login']
        && request.resource.data.a is string && request.resource.data.a.size() <= 40
        && request.resource.data.b is string && request.resource.data.b.size() <= 40
        && request.resource.data.at == request.time;
    }

    // R3.5 build 8 봇 덱 통계 (익명 집계): botstats/<지후 id 또는 b_<덱 평균 티어 구간>> = { g1~g10 판 수 · w1~w10 봇이 이긴 판 수 } · 쓰기는 한 번에 키마다 +1 까지만 (increment) · 읽기는 운영자만
    function bsStep(k) { return request.resource.data.get(k, 0) - (resource == null ? 0 : resource.data.get(k, 0)); }
    match /botstats/{id} {
      allow get, list: if isAdmin();
      allow create, update: if request.auth != null && id.matches('^[a-z_][a-z0-9_]{0,23}$')
        && request.resource.data.keys().hasOnly(['g1', 'g2', 'g3', 'g4', 'g5', 'g6', 'g7', 'g8', 'g9', 'g10', 'w1', 'w2', 'w3', 'w4', 'w5', 'w6', 'w7', 'w8', 'w9', 'w10'])
        && bsStep('g1') >= 0 && bsStep('g1') <= 1 && bsStep('g2') >= 0 && bsStep('g2') <= 1 && bsStep('g3') >= 0 && bsStep('g3') <= 1 && bsStep('g4') >= 0 && bsStep('g4') <= 1 && bsStep('g5') >= 0 && bsStep('g5') <= 1 && bsStep('g6') >= 0 && bsStep('g6') <= 1 && bsStep('g7') >= 0 && bsStep('g7') <= 1 && bsStep('g8') >= 0 && bsStep('g8') <= 1 && bsStep('g9') >= 0 && bsStep('g9') <= 1 && bsStep('g10') >= 0 && bsStep('g10') <= 1 && bsStep('w1') >= 0 && bsStep('w1') <= 1 && bsStep('w2') >= 0 && bsStep('w2') <= 1 && bsStep('w3') >= 0 && bsStep('w3') <= 1 && bsStep('w4') >= 0 && bsStep('w4') <= 1 && bsStep('w5') >= 0 && bsStep('w5') <= 1 && bsStep('w6') >= 0 && bsStep('w6') <= 1 && bsStep('w7') >= 0 && bsStep('w7') <= 1 && bsStep('w8') >= 0 && bsStep('w8') <= 1 && bsStep('w9') >= 0 && bsStep('w9') <= 1 && bsStep('w10') >= 0 && bsStep('w10') <= 1;
    }

    // R3.1 실시간 동접 (로비 소식 줄): 접속자마다 1분마다 at 만 · 수를 세려면 list
    // R3.5 build 3: 접속 중인 유저 목록 (누구나 읽는다) pres/<uid> = { n 닉네임, lv, fav 대표 지후, fr 테두리, dk 덱 (5개 이하), at }
    match /pres/{userId} {
      allow list: if request.auth != null;
      allow create, update: if owner(userId) && request.resource.data.keys().hasOnly(['n', 'lv', 'fav', 'fr', 'dk', 'at'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 12
        && request.resource.data.lv is int
        && request.resource.data.fav is string && request.resource.data.fav.size() <= 24
        && request.resource.data.fr is string && request.resource.data.fr.size() <= 24
        && request.resource.data.dk is list && request.resource.data.dk.size() <= 5
        && request.resource.data.at == request.time;
    }

    match /pulse/{userId} {
      allow list: if request.auth != null;
      allow create, update: if owner(userId) && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time;
    }

    // R3.3 build 3 지후 복권: 날마다 행운의 숫자 = lotto/<한국 날 번호> 의 서버 시각 at 으로 만든다 · 그날이 끝난 다음 날 (한국 시간) 에 처음 연 사람이 한 번만 만든다 · 고칠 수 없다
    match /lotto/{day} {
      allow get: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.keys().hasOnly(['at']) && request.resource.data.at == request.time
        && int(day) == math.floor((request.time.toMillis() + 32400000) / 86400000) - 1;
      allow update, delete: if false;
    }

    // 잠수함 접속 중인 유저 (운영 도구): 접속자마다 1분마다 닉네임 · 화면 · 레벨 · 회원 여부 · 접속 횟수 · 지난 접속 · 기기 · 유입 · 운영자만 읽는다
    match /live/{userId} {
      allow get, list: if isAdmin();
      allow create, update: if owner(userId) && request.resource.data.keys().hasOnly(['n', 'w', 'lv', 'm', 'at', 'vn', 'pv', 'gp', 'f', 'old', 'pf', 'ap', 'src', 'tst'])
        && request.resource.data.n is string && request.resource.data.n.size() <= 12
        && request.resource.data.w is string && request.resource.data.w.size() <= 16
        && request.resource.data.lv is int && request.resource.data.m is bool
        && (!('vn' in request.resource.data) || (request.resource.data.vn is int && request.resource.data.pv is int && request.resource.data.gp is int && request.resource.data.f is int && request.resource.data.old is bool && request.resource.data.ap is bool))
        && (!('pf' in request.resource.data) || (request.resource.data.pf is string && request.resource.data.pf.size() <= 24 && request.resource.data.src is string && request.resource.data.src.size() <= 32))
        && (!('tst' in request.resource.data) || request.resource.data.tst is bool)
        && request.resource.data.at == request.time;
    }

    // ── 친구 · 접속 상태 · 1:1 채팅 ──
    // 접속 상태: 로그인한 사람은 누구나 읽고, 자기 것만 쓴다 (sp = 관전할 수 있는 친선전 번호 · frame 프로필 테두리 · fav 대표 지후)
    match /presence/{userId} {
      allow get: if request.auth != null;
      allow create, update: if owner(userId)
        && request.resource.data.keys().hasOnly(['nickname', 'where', 'at', 'sp', 'frame', 'fav'])
        && (!('sp' in request.resource.data) || (request.resource.data.sp is string && request.resource.data.sp.size() <= 80))
        && (!('frame' in request.resource.data) || (request.resource.data.frame is string && request.resource.data.frame.matches('^[a-z0-9]{1,8}$')))
        && (!('fav' in request.resource.data) || (request.resource.data.fav is string && request.resource.data.fav.matches('^[a-z_]{0,24}$')))
        && request.resource.data.nickname is string && request.resource.data.nickname.size() <= 12
        && request.resource.data.where is string && request.resource.data.where.size() <= 12
        && request.resource.data.at == request.time;
    }
    // 친구 관계: 문서 ID '작은UID_큰UID'. 요청한 사람이 만들고(pending), 받은 사람만 수락(accepted). 둘 중 누구나 삭제
    function friendOk(pairId) {
      let f = get(/databases/$(database)/documents/friendships/$(pairId));
      return f.data.status == 'accepted' && request.auth.uid in f.data.members;
    }
    function friendsWith(other) {
      return friendOk(request.auth.uid < other ? request.auth.uid + '_' + other : other + '_' + request.auth.uid);
    }
    match /friendships/{pairId} {
      allow get: if request.auth != null && (resource == null || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['members', 'names', 'status', 'from', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members
        && request.resource.data.members[0] < request.resource.data.members[1]
        && pairId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && request.auth.uid in resource.data.members
        && request.auth.uid != resource.data.from
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'names', 'at'])
        && request.resource.data.status == 'accepted'
        && request.resource.data.names is map
        && request.resource.data.at == request.time;
      allow delete: if request.auth != null && request.auth.uid in resource.data.members;
    }
    // 1:1 채팅: 친구가 된 두 사람만 읽고 쓴다
    match /dm/{pairId}/msgs/{msgId} {
      allow read: if request.auth != null && friendOk(pairId);
      allow create: if request.auth != null && !banned() && friendOk(pairId)
        && request.resource.data.keys().hasOnly(['uid', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 200
        && request.resource.data.at == request.time;
    }

    // ── 친선전 (온라인 1:1) · 관전 ──
    // 방장(host)이 친구(guest)에게 신청. 두 사람만 상태 · 참가자 덱을 바꾼다. 진행 중인 판은 두 선수의 친구도 읽는다(관전).
    // cs = 코인 지후 시세 칸 (두 화면이 같은 값을 쓴다)
    function matchMember(id) {
      let m = get(/databases/$(database)/documents/matches/$(id));
      return request.auth.uid == m.data.host || request.auth.uid == m.data.guest;
    }
    function matchSpectator(id) {
      let m = get(/databases/$(database)/documents/matches/$(id));
      return m.data.status in ['playing', 'done'] && (friendsWith(m.data.host) || friendsWith(m.data.guest));
    }
    match /matches/{id} {
      allow get: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest
        || (resource.data.status in ['playing', 'done'] && (friendsWith(resource.data.host) || friendsWith(resource.data.guest))));
      allow list: if request.auth != null && request.auth.uid == resource.data.guest;
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['host', 'guest', 'hostName', 'guestName', 'hostDeck', 'guestDeck', 'status', 'seed', 'cs', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string && request.resource.data.guest != request.auth.uid
        && friendsWith(request.resource.data.guest)
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 12
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 12
        && validDeck(request.resource.data.hostDeck) && request.resource.data.guestDeck is list && request.resource.data.guestDeck.size() == 0
        && request.resource.data.status == 'invite'
        && request.resource.data.seed is int
        && (!('cs' in request.resource.data) || request.resource.data.cs is int)
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guestDeck', 'at'])
        && request.resource.data.status in ['invite', 'accepted', 'declined', 'cancel', 'playing', 'done']
        && validDeck(request.resource.data.guestDeck)
        && request.resource.data.at == request.time;
    }
    match /matches/{id}/msgs/{msgId} {
      allow read: if request.auth != null && (matchMember(id) || matchSpectator(id));
      allow create: if request.auth != null && matchMember(id)
        && request.resource.data.keys().hasOnly(['from', 'body', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.at == request.time;
    }
    // R3.4 build 7 일반전 온라인 매칭: 대기열 mmq/<uid> · 경기 omatch/<id> (+ msgs)
    function mmDoc(d) {
      return d.keys().hasOnly(['n', 'deck', 'lv', 'fr', 'ph', 'st', 'mid', 'by', 'at'])
        && d.n is string && d.n.size() <= 12 && validDeck(d.deck) && d.lv is int
        && d.st in ['wait', 'matched'] && d.at == request.time;
    }
    match /mmq/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && !banned() && request.auth.uid == uid && mmDoc(request.resource.data) && request.resource.data.st == 'wait';
      allow update: if request.auth != null && !banned() && (
        (request.auth.uid == uid && mmDoc(request.resource.data))
        || (resource.data.st == 'wait' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'mid', 'by', 'at'])
          && request.resource.data.st == 'matched' && request.resource.data.by == request.auth.uid && request.resource.data.at == request.time));
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    function omMember(id) {
      let m = get(/databases/$(database)/documents/omatch/$(id));
      return request.auth.uid == m.data.host || request.auth.uid == m.data.guest;
    }
    match /omatch/{id} {
      allow get: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest);
      allow create: if request.auth != null && !banned()
        && request.resource.data.keys().hasOnly(['host', 'guest', 'hostName', 'guestName', 'hostDeck', 'guestDeck', 'status', 'seed', 'cs', 'at'])
        && request.resource.data.host == request.auth.uid
        && request.resource.data.guest is string && request.resource.data.guest != request.auth.uid
        && getAfter(/databases/$(database)/documents/mmq/$(request.resource.data.guest)).data.mid == id
        && request.resource.data.hostName is string && request.resource.data.hostName.size() <= 12
        && request.resource.data.guestName is string && request.resource.data.guestName.size() <= 12
        && validDeck(request.resource.data.hostDeck) && validDeck(request.resource.data.guestDeck)
        && request.resource.data.status == 'playing' && request.resource.data.seed is int
        && (!('cs' in request.resource.data) || request.resource.data.cs is int)
        && request.resource.data.at == request.time;
      allow update: if request.auth != null && (request.auth.uid == resource.data.host || request.auth.uid == resource.data.guest)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'guestDeck', 'at'])
        && request.resource.data.status in ['playing', 'done']
        && validDeck(request.resource.data.guestDeck)
        && request.resource.data.at == request.time;
    }
    match /omatch/{id}/msgs/{msgId} {
      allow read: if request.auth != null && omMember(id);
      allow create: if request.auth != null && omMember(id)
        && request.resource.data.keys().hasOnly(['from', 'body', 'at'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.body is string && request.resource.data.body.size() <= 4000
        && request.resource.data.at == request.time;
    }
  }
}
